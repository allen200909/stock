{===============================================================}
{ V2.2-E4 AMOUNT Activity Variant — Experimental               }
{ Replace share-volume RVOL with relative transaction amount.   }
{===============================================================}

N:=60; ATRN:=14; AMTN:=20;
ZTH:=1.50; RAVAC:=1.20; RATH:=1.50;
RACAP:=3.00; MVCAP:=4.00;
DTH:=0.25; ATH:=0.10; CTH:=0.10;
COOL:=3;
WDR:=0.50; WDB:=0.25; WCV:=0.25;

PC:=REF(C,1);
TRX:=MAX(H-L,MAX(ABS(H-PC),ABS(L-PC)));
ATR0:=SMA(TRX,ATRN,1);
ATRB:=REF(ATR0,1);
TROK:=ATRB>0.0001;
MOV:=IF(TROK,TRX/ATRB,0);

AM0:=MA(AMOUNT,AMTN);
AB:=REF(AM0,1);
AOK:=AB>0;
RARAW:=IF(AOK,AMOUNT/AB,1);

RAFIT:=MIN(RARAW,RACAP);
MVFIT:=MIN(MOV,MVCAP);

LX:=REF(RAFIT,1);
LY:=REF(MVFIT,1);
MX:=MA(LX,N);
MY:=MA(LY,N);
CXY:=MA(LX*LY,N)-MX*MY;
VX:=MA(LX*LX,N)-MX*MX;

REGK:=IF(VX>0.0001,MAX(CXY/VX,0),0);
REGB:=MY-REGK*MX;

EXPECT:=MAX(REGB+REGK*RAFIT,0);
RES:=MOV-EXPECT;

RM:=MA(REF(RES,1),N);
RS:=STD(REF(RES,1),N);
ZR:=IF(RS>0.0001,(RES-RM)/RS,0);

WN:=2*N+MAX(ATRN,AMTN)+5;
VALID:=BARSCOUNT(C)>WN AND TROK AND AOK AND RS>0.0001;
Z:=IF(VALID,ZR,0);

TRB:=MAX(TRX,0.001);
DR:=(C-PC)/TRB;
DB:=(C-O)/TRB;
CLV:=IF(H>L,(2*C-H-L)/(H-L),0);
WS:=MAX(WDR+WDB+WCV,0.0001);
DIR:=(WDR*DR+WDB*DB+WCV*CLV)/WS;

EU0:=VALID AND Z>ZTH AND DIR>DTH AND RARAW>=RAVAC;
ABU0:=VALID AND Z<-ZTH AND RARAW>RATH AND DIR>ATH AND CLV>CTH;

EU:=EU0 AND COUNT(REF(EU0,1),COOL)=0;
ABU:=ABU0 AND COUNT(REF(ABU0,1),COOL)=0;

零轴:0,COLORGRAY;
上阈:ZTH,DOTLINE,COLORRED;
下阈:-ZTH,DOTLINE,COLORGREEN;

STICKLINE(Z>=0,0,Z,2,1),COLOR505050;
STICKLINE(Z<0,0,Z,2,1),COLOR333333;
STICKLINE(EU0,0,Z,2,0),COLORYELLOW;
STICKLINE(ABU0,0,Z,2,0),COLORMAGENTA;

金额残差Z:Z,COLORWHITE,LINETHICK2;

量扩多:EU,NODRAW;
吸收多:ABU,NODRAW;
金额比:RARAW,NODRAW;
