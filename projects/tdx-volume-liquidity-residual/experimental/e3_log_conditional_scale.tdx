{===============================================================}
{ V2.2-E3 Log-Linear + Conditional Scale — Experimental        }
{ First model log-MOV on log-RVOL, then model |RES| scale.      }
{===============================================================}

N:=60; ATRN:=14; VOLN:=20;
ZTH:=1.50; RVVAC:=1.20; RVTH:=1.50;
RVCAP:=3.00; MVCAP:=4.00;
DTH:=0.25; ATH:=0.10; CTH:=0.10;
COOL:=3;
WDR:=0.50; WDB:=0.25; WCV:=0.25;

PC:=REF(C,1);
TRX:=MAX(H-L,MAX(ABS(H-PC),ABS(L-PC)));
ATR0:=SMA(TRX,ATRN,1);
ATRB:=REF(ATR0,1);
TROK:=ATRB>0.0001;
MOV:=IF(TROK,TRX/ATRB,0);

VM0:=MA(VOL,VOLN);
VB:=REF(VM0,1);
VOK:=VB>0;
RVRAW:=IF(VOK,VOL/VB,1);

LRV:=LN(MAX(MIN(RVRAW,RVCAP),0.05));
LMV:=LN(MAX(MIN(MOV,MVCAP),0.05));

LX:=REF(LRV,1);
LY:=REF(LMV,1);
MX:=MA(LX,N);
MY:=MA(LY,N);
CXY:=MA(LX*LY,N)-MX*MY;
VX:=MA(LX*LX,N)-MX*MX;
VY:=MA(LY*LY,N)-MY*MY;

REGK:=IF(VX>0.0001,MAX(CXY/VX,0),0);
REGB:=MY-REGK*MX;

LNOW:=LN(MAX(MOV,0.05));
RES:=LNOW-(REGB+REGK*LRV);

AR:=REF(ABS(RES),1);
MAR:=MA(AR,N);
CAR:=MA(LX*AR,N)-MX*MAR;
KSC:=IF(VX>0.0001,CAR/VX,0);

SC0:=MAR+KSC*(LRV-MX);
SC:=MAX(SC0,0.05);

U:=RES/SC;

UM:=MA(REF(U,1),N);
US:=STD(REF(U,1),N);
ZR:=IF(US>0.0001,(U-UM)/US,0);

RHO:=IF(VX>0.0001 AND VY>0.0001,CXY/SQRT(VX*VY),0);

WN:=2*N+MAX(ATRN,VOLN)+5;
VALID:=BARSCOUNT(C)>WN AND TROK AND VOK AND US>0.0001;
Z:=IF(VALID,ZR,0);

TRB:=MAX(TRX,0.001);
DR:=(C-PC)/TRB;
DB:=(C-O)/TRB;
CLV:=IF(H>L,(2*C-H-L)/(H-L),0);
WS:=MAX(WDR+WDB+WCV,0.0001);
DIR:=(WDR*DR+WDB*DB+WCV*CLV)/WS;

JUMBO:=RVRAW>RVCAP;

VU0:=VALID AND NOT(JUMBO) AND Z>ZTH AND DIR>DTH AND RVRAW<RVVAC;
EU0:=VALID AND NOT(JUMBO) AND Z>ZTH AND DIR>DTH AND RVRAW>=RVVAC;
ABU0:=VALID AND NOT(JUMBO) AND Z<-ZTH AND RVRAW>RVTH AND DIR>ATH AND CLV>CTH;

VU:=VU0 AND COUNT(REF(VU0,1),COOL)=0;
EU:=EU0 AND COUNT(REF(EU0,1),COOL)=0;
ABU:=ABU0 AND COUNT(REF(ABU0,1),COOL)=0;

零轴:0,COLORGRAY;
上阈:ZTH,DOTLINE,COLORRED;
下阈:-ZTH,DOTLINE,COLORGREEN;

STICKLINE(Z>=0,0,Z,2,1),COLOR505050;
STICKLINE(Z<0,0,Z,2,1),COLOR333333;
STICKLINE(VU0,0,Z,2,0),COLORRED;
STICKLINE(EU0,0,Z,2,0),COLORYELLOW;
STICKLINE(ABU0,0,Z,2,0),COLORMAGENTA;

条件残差Z:Z,COLORWHITE,LINETHICK2;

真空多:VU,NODRAW;
量扩多:EU,NODRAW;
吸收多:ABU,NODRAW;
巨量标记:JUMBO,NODRAW;
条件尺度:SC,NODRAW;
模型RHO:RHO,NODRAW;
